# VaderShell — copy to `.env` and fill in REAL values. (.env is gitignored.)

# ── Brain selection ──
# Which brain: claude | kimi | openrouter | claude-api
#   claude     → Claude on your subscription via the real `claude` CLI (needs NOTHING below)
#   kimi       → Kimi via a direct key
#   openrouter → any model via OpenRouter
#   claude-api → Claude via a raw API token (rate-limited — avoid)
VADER_PROVIDER=claude

# Claude model. Defaults to Opus; the gateway launcher overrides this to Sonnet
# (lighter for phone use). Uncomment to pin a model for the terminal too.
# VADER_CLAUDE_MODEL=claude-opus-4-8

# Model for the kimi/openrouter paths (also the council's Kimi side).
VADER_MODEL=moonshotai/kimi-k2.5

# ── Keys (only for the path you use) ──
# The default `claude` path uses your Claude Code CLI login — needs NOTHING here.
# Only the claude-api path uses one of these (get a token via `claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-REPLACE_ME
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME        # pay-as-you-go alternative for claude-api
# OpenRouter — for VADER_PROVIDER=openrouter AND the council's Kimi half.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Direct Kimi — only if VADER_PROVIDER=kimi.
# KIMI_API_KEY=sk-kimi-REPLACE_ME

# ── Discord gateway ──
DISCORD_BOT_TOKEN=REPLACE_WITH_YOUR_DISCORD_BOT_TOKEN
# Your Discord user ID — VADER obeys only this user (blank = anyone in the server).
VADER_DISCORD_UID=YOUR_DISCORD_USER_ID
# Lock VADER to specific channels (comma-separated ids). Blank = any channel it sees.
# VADER_DISCORD_CHANNEL_ID=

# ── SSH peer (optional) — the other machine, for the ssh_run tool (key auth only) ──
# VADER_SSH_HOST=192.168.1.92
# VADER_SSH_USER=gwu07
# VADER_SSH_PORT=22
# VADER_SSH_KEY=~/.ssh/id_ed25519

# ── Coalition mode (optional) ──
# In this server (and/or one channel), VADER reads a PEER bot's replies and posts a
# second opinion. Optionally pin one peer bot id; blank = any bot in scope.
# (The peer MUST ignore bots, or it loops.)
# VADER_COALITION_SERVER_ID=
# VADER_COALITION_CHANNEL_ID=
# VADER_PEER_BOT_ID=

# ── Agent workspace & vision (kimi/openrouter tool path) ──
# Where VADER clones/creates/builds repos and runs commands. Default: ~/vader-workspace.
# VADER_WORKSPACE=C:\Users\veren\vader-workspace
# Feed screenshots back to the model as images so it can SEE them (needs a vision
# model — Kimi K2.5 qualifies). Set 0 to disable and only save PNGs to disk.
# VADER_VISION=1
# Persistent memory + learned skills live here (survive restarts). Default ~/.vader.
# VADER_HOME=C:\Users\veren\.vader
# ── TalkyTalk voice output (optional) ──
# Enable Discord voice summaries: the bot can attach spoken MP3s to replies.
# Uses the existing C:\Users\gwu07\machine-spirit\talkytalk\talkytalk.py script.
# VADER_TTS_ENABLED=true
# ELEVENLABS_API_KEY=***  # optional — script already has its own .env

# ── Advanced overrides (defaults shown; rarely needed) ──
# KIMI_BASE_URL=https://api.kimi.com/coding/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
