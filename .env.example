# VaderShell — copy to `.env` and fill in REAL values. (.env is gitignored.)

# Which brain. Switch by changing this one line:
#   claude     → Claude via the real `claude` CLI (uses your Claude Code login; no token needed)
#   kimi       → Kimi via your sk-kimi key
#   openrouter → any model via OpenRouter
#   claude-api → Claude via a raw API/OAuth token (rate-limited; not recommended)
VADER_PROVIDER=claude

# Model for the kimi/openrouter paths (ignored on the claude CLI path).
VADER_MODEL=moonshotai/kimi-k2.5

# Only for the claude-api path (the default `claude` path needs NOTHING here).
# Get one with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-REPLACE_ME

# For VADER_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# For VADER_PROVIDER=kimi
# KIMI_API_KEY=sk-kimi-REPLACE_ME

# ── Discord gateway ──
# Bot token from the Discord developer portal (Bot tab → Reset Token).
DISCORD_BOT_TOKEN=REPLACE_WITH_YOUR_DISCORD_BOT_TOKEN
# Your Discord user ID (Developer Mode → right-click your name → Copy User ID).
# VADER obeys only this user; leave blank to allow anyone in the server.
VADER_DISCORD_UID=
